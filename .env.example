# Copy to .env.local. Only EXPO_PUBLIC_* values are bundled into the app.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Without them, crash reporting and analytics stay off.
# Both are public by design (they only allow sending events, not reading them).
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Build-time only (source map upload), never EXPO_PUBLIC_: set it as an EAS secret.
# SENTRY_AUTH_TOKEN=
