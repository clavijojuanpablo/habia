{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/add/:username",
      "destination": "/invite"
    },
    {
      "source": "/join/:code",
      "destination": "/invite"
    }
  ]
}
